[Unit]
Description=pii-guard-daemon (gramatr guards plugin)
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/pii-guard-daemon
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
Environment=PII_GUARD_HOST=127.0.0.1
Environment=PII_GUARD_PORT=8731

# --- Hardening ---
# Measured this session: ~760MB RSS, no GPU use. No external cache
# needed — en_core_web_lg is baked into the uv tool's own install
# (read-only after install), so ProtectSystem=strict needs no
# ReadWritePaths exception here, unlike injection-guard.
#
# Same cgroup-delegation caveat as injection-guard-daemon.service — see
# that file's comment. Not independently re-verified here, same
# underlying mechanism.
MemoryMax=1.5G
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
