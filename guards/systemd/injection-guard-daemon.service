[Unit]
Description=injection-guard-daemon (gramatr guards plugin)
After=network.target

[Service]
Type=simple
# EnvironmentFile must supply HF_TOKEN — a Hugging Face token that has
# accepted Llama Prompt Guard 2's gated license. This cannot be
# automated: accepting someone else's license is inherently a manual,
# per-user step. guards-selfheal.sh checks for this file (and its
# permissions) and warns clearly if either is wrong, rather than let
# this service silently crash-loop with no explanation.
EnvironmentFile=-%h/.config/gramatr-guards/injection-guard.env
ExecStart=%h/.local/bin/injection-guard-daemon
Restart=on-failure
RestartSec=5
# Crash-loop protection: without this, a missing/bad HF_TOKEN restarts
# every 5s forever, burning CPU indefinitely on a single-user box doing
# other work. 5 restarts in 60s -> give up and stay stopped; `systemctl
# --user reset-failed injection-guard-daemon && systemctl --user start
# injection-guard-daemon` after fixing the actual problem.
StartLimitIntervalSec=60
StartLimitBurst=5
Environment=INJECTION_GUARD_HOST=127.0.0.1
Environment=INJECTION_GUARD_PORT=8730
Environment=INJECTION_GUARD_DEVICE=auto

# --- Hardening ---
# Measured this session (RTX 4090, cuda device): ~900MB-1GB RSS,
# ~1GB VRAM. MemoryMax set with real headroom above the measured
# number, not a guess — a leak/bug gets OOM-killed by systemd (then
# restarted, subject to the crash-loop limit above) instead of
# consuming unbounded RAM on a single-user box doing other work.
#
# CAVEAT, found by actually checking, not assumed: this directive is
# only enforced if the memory cgroup controller is delegated to your
# user systemd instance. Verify on YOUR machine with:
#   systemctl --user show injection-guard-daemon -p ControlGroup --value
#   cat "/sys/fs/cgroup$(systemctl --user show injection-guard-daemon -p ControlGroup --value)/memory.max"
# If that file doesn't exist or doesn't show ~2147483648, this limit is
# accepted by systemd but not actually enforced on your system (true in
# this build's own sandboxed dev environment — cgroup.controllers was
# empty at every level checked — status on a normal non-sandboxed
# Linux install is expected to differ, but is NOT verified here).
MemoryMax=2G
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Needs write access for the HF model cache (model download/cache) —
# everything else stays read-only per ProtectSystem=strict above.
ReadWritePaths=%h/.cache/huggingface

[Install]
WantedBy=default.target
