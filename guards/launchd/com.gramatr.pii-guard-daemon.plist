<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  UNVERIFIED ON REAL macOS — see injection-guard's plist in this same
  directory for the full caveat. No gated model here (en_core_web_lg is
  MIT, baked in as a normal dependency), so no HF_TOKEN needed — this
  one is simpler.

  Install: cp this file to ~/Library/LaunchAgents/, then
  `launchctl load ~/Library/LaunchAgents/com.gramatr.pii-guard-daemon.plist`
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gramatr.pii-guard-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.local/bin/pii-guard-daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PII_GUARD_HOST</key>
    <string>127.0.0.1</string>
    <key>PII_GUARD_PORT</key>
    <string>8731</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/pii-guard-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pii-guard-daemon.log</string>
</dict>
</plist>
