<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  UNVERIFIED ON REAL macOS: written carefully against documented
  launchd.plist syntax, but this session had no Mac to actually test
  on (unlike the systemd units in ../systemd/, which were run end to
  end on a real systemd user session). Treat this as a best effort
  starting point, not a verified artifact, until someone confirms it
  on a real Mac. See README "Known limitations."

  Install: cp this file to ~/Library/LaunchAgents/, then
  launchctl load ~/Library/LaunchAgents/com.gramatr.injection-guard-daemon.plist

  HF_TOKEN must be set in the EnvironmentVariables block below, or in
  ~/.config/gramatr-guards/injection-guard.env sourced some other way:
  launchd does NOT support an EnvironmentFile directive the way systemd
  does, so this cannot read that file directly. guards-selfheal.sh's
  macOS path is not yet implemented (it logs a message pointing here
  instead). See README.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gramatr.injection-guard-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.local/bin/injection-guard-daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>INJECTION_GUARD_HOST</key>
    <string>127.0.0.1</string>
    <key>INJECTION_GUARD_PORT</key>
    <string>8730</string>
    <key>INJECTION_GUARD_DEVICE</key>
    <string>auto</string>
    <key>HF_TOKEN</key>
    <string>REPLACE_WITH_YOUR_HF_TOKEN</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/injection-guard-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/injection-guard-daemon.log</string>
</dict>
</plist>
